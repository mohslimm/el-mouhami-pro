{
  "name": "el-mouhami-pro-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "El-Mouhami Pro — Suite Juridique Unifiée (Desktop, Mobile, Backend)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --prefix apps/desktop app:dev",
    "build": "npm run --prefix apps/desktop app:build",
    "desktop:dev": "npm run --prefix apps/desktop app:dev",
    "desktop:build": "npm run --prefix apps/desktop app:build",
    "desktop:preview": "npm run --prefix apps/desktop preview",
    "mobile:start": "npm run --prefix apps/mobile start",
    "mobile:android": "npm run --prefix apps/mobile android",
    "mobile:ios": "npm run --prefix apps/mobile ios",
    "mobile:web": "npm run --prefix apps/mobile web",
    "mobile:typecheck": "npm run --prefix apps/mobile typecheck",
    "dashboard:dev": "npm run --prefix apps/dashboard dev",
    "dashboard:build": "npm run --prefix apps/dashboard build",
    "dashboard:preview": "npm run --prefix apps/dashboard preview"
  }
}
