{
  "name": "el-mouhami-pro-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "El-Mouhami Pro — Suite Juridique Unifiée (Desktop, Mobile, Backend)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --prefix apps/desktop app:dev",
    "build": "npm run --prefix apps/desktop app:build",
    "desktop:dev": "npm run --prefix apps/desktop app:dev",
    "desktop:build": "npm run --prefix apps/desktop app:build",
    "desktop:preview": "npm run --prefix apps/desktop preview"
  }
}
